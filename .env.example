# Host-specific IDs for docker-compose.yml. Copied to .env by
# scripts/setup.sh (which fills in this machine's real values); .env is
# gitignored. Backend selection lives separately in backend.env.

# Your user/group -- the container runs as this so files it writes into
# ./processed are owned by you, not root.
HOST_UID=1000
HOST_GID=1000

# GID of the host's `video` / `render` groups, added to the container so
# it can reach /dev/kfd and /dev/dri. Find with: getent group video render
VIDEO_GID=44
RENDER_GID=992

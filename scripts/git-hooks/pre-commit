#!/bin/sh
# Runs the rule tests before a commit is made; a failure stops the commit.
# Installed by scripts/install_hooks.sh (git does not copy hooks on clone).
# Under a second, no model, no container. To commit anyway: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
for t in evals/test_rules.py evals/test_glossary_table.py; do
    out=$(python3 "$t" 2>&1)
    if [ $? -ne 0 ]; then
        echo "$out" | grep -E "FAIL|passed" >&2
        echo "pre-commit: $t failed -- commit stopped (git commit --no-verify to override)" >&2
        exit 1
    fi
done
exit 0

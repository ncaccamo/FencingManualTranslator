# Backend selection for BookTranslator model serving.
# Copy to backend.env and edit. Changing values + `docker compose up -d`
# recreates the container with the new settings -- NO image rebuild
# (both local backends are baked into the image).
#
# backend.env is gitignored (it can hold REMOTE_API_KEY).
# Keep KEY=value lines clean -- no trailing inline comments (compose's
# env_file parser is picky about them across versions).

# local | remote
BACKEND_MODE=local

# ---------- BACKEND_MODE=local ----------
# Which prebuilt llama.cpp backend the container runs:
#   vulkan   - mesa RADV via the LunarG SDK (default, most portable)
#   rocm7    - ROCm 7.2.4 stable HIP build
#   rocm714  - ROCm 7.14 preview (NOT built yet; selecting it fails with a
#              pointer to BackendBuildstage)
LLAMA_BACKEND=vulkan

# ---------- BACKEND_MODE=remote ----------
# Point the pipeline at a llama-server on another machine over the LAN
# (e.g. llama-server.exe on a Windows GPU box). Only ONE model loads on
# that box at a time, so load the vision model before the OCR step and the
# text model before the translate step. Both 1_ocr_and_extract_vlm.py and
# 2_translate.py hit this one endpoint.
REMOTE_HOST=
REMOTE_PORT=11500
REMOTE_API_KEY=

# The user's private working data -- never committed. The repo is a
# general fencing-manual translation pipeline; the specific corpus, its
# registry, gold reference pairs, and per-book eval baselines belong to
# whoever runs it, not to the product.
books/
processed/
evals/gold/*
!evals/gold/.gitkeep
evals/baselines/*
!evals/baselines/.gitkeep
evals/reports/*
!evals/reports/.gitkeep

# Python
__pycache__/
*.pyc

# Model files (these live in ~/llm_models anyway, outside this folder,
# but excluding just in case one ever ends up here)
*.gguf

# Environment
.env
# Backend selection (may hold REMOTE_API_KEY); .example is tracked
backend.env
review-notes/

# Host-specific compose override (remote/GPU-less). .example is tracked.
docker-compose.override.yml
build.log

# shareable copies of finished PDFs (scripts/release.py)
release/
